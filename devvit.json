{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "stonefall99",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "index.html",
        "height": "tall",
        "inline": true
      },
      "game": {
        "entry": "index.html",
        "height": "tall",
        "inline": false
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "media": {
    "dir": "assets"
  },
  "permissions": {
    "redis": true,
    "reddit": {
      "enable": true,
      "scope": "user",
      "asUser": [
        "SUBMIT_POST"
      ]
    }
  },
  "menu": {
    "items": [
      {
        "label": "Create Stonefall Game Post",
        "description": "Start a new Stonefall tower game",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "[Dev] Import Tower Data",
        "description": "Seed Redis with tower data JSON",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/import-data"
      },
      {
        "label": "Create Elo Leaderboard Post",
        "description": "Create a standalone Stonefall leaderboard window",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create-leaderboard"
      },
      {
        "label": "[Storage] 1. Cleanup Dry Run",
        "description": "Estimate reclaimable Redis space without deleting anything",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/cleanup-dry-run"
      },
      {
        "label": "[Storage] 2. Cleanup Status",
        "description": "Show progress and findings of the last cleanup run",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/cleanup-status"
      },
      {
        "label": "[Storage] 3. Purge Legacy Data",
        "description": "Destructive: reclaim Redis space. Run the dry run first",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/cleanup-run"
      }
    ]
  },
  "forms": {
    "importDataForm": "/internal/form/import-data",
    "cleanupConfirmForm": "/internal/form/cleanup-confirm"
  },
  "triggers": {
    "onPostDelete": "/internal/on-post-delete",
    "onCommentDelete": "/internal/on-comment-delete"
  },
  "scheduler": {
    "tasks": {
      "daily-reset": {
        "endpoint": "/internal/scheduler/daily-reset",
        "cron": "0 0 * * *"
      },
      "storage-cleanup": {
        "endpoint": "/internal/scheduler/storage-cleanup"
      }
    }
  },
  "dev": {
    "subreddit": "stonefall99_dev2"
  }
}
