{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "stonefall99",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "index.html",
        "height": "tall",
        "inline": true
      },
      "game": {
        "entry": "index.html",
        "height": "tall",
        "inline": false
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "media": {
    "dir": "assets"
  },
  "permissions": {
    "redis": true,
    "reddit": {
      "enable": true,
      "scope": "user",
      "asUser": [
        "SUBMIT_POST"
      ]
    }
  },
  "menu": {
    "items": [
      {
        "label": "Create Stonefall Game Post",
        "description": "Start a new Stonefall tower game",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "[Dev] Import Tower Data",
        "description": "Seed Redis with tower data JSON",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/import-data"
      }
    ]
  },
  "forms": {
    "importDataForm": "/internal/form/import-data"
  },
  "triggers": {
    "onPostDelete": "/internal/on-post-delete",
    "onCommentDelete": "/internal/on-comment-delete"
  },
  "scheduler": {
    "tasks": {
      "daily-reset": {
        "endpoint": "/internal/scheduler/daily-reset",
        "cron": "0 0 * * *"
      }
    }
  },
  "dev": {
    "subreddit": "stonefall99_dev2"
  }
}
