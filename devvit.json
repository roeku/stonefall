{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "stonefall99",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "index.html",
        "height": "tall",
        "inline": true
      },
      "relay": {
        "entry": "index.html",
        "height": "tall",
        "inline": true
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "journeys": true,
    "redis": true,
    "realtime": true,
    "reddit": {
      "enable": true,
      "scope": "user",
      "asUser": ["SUBMIT_COMMENT"]
    }
  },
  "menu": {
    "items": [
      {
        "label": "Create today's map post",
        "description": "The shared grid for today. Safe to run twice; it finds the existing one.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Create today's relay post",
        "description": "The shared towers for today. Safe to run twice; it finds the existing one.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/relay-post-create"
      },
      {
        "label": "[Storage] 1. Purge dry run",
        "description": "Report what a purge of today's map would remove. Changes nothing.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/purge-dry-run"
      },
      {
        "label": "[Storage] 2. Purge all game data",
        "description": "Destructive. Clears today's map, today's relay and the score table. Requires typing the subreddit name.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/purge"
      }
    ]
  },
  "forms": {
    "purgeConfirmForm": "/internal/form/purge-confirm"
  },
  "triggers": {
    "onAppInstall": "/internal/on-app-install",
    "onAppUpgrade": "/internal/on-app-upgrade",
    "onCommentDelete": "/internal/on-comment-delete"
  },
  "scheduler": {
    "tasks": {
      "board-rebuild": {
        "endpoint": "/internal/scheduler/board-rebuild",
        "cron": "17 * * * *"
      },
      "daily": {
        "endpoint": "/internal/scheduler/daily",
        "cron": "0 12 * * *"
      }
    }
  },
  "dev": {
    "subreddit": "stonefall99_dev2"
  },
  "sourceIgnores": ["archive/", ".claude/", ".cursor/", ".cursorignore", ".vscode/"]
}
