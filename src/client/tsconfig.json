// TypeScript config for all web view main thread code.
{
  "extends": "../../tools/tsconfig-base.json",
  "compilerOptions": {
    // Target the browser.
    "customConditions": ["browser"],

    "lib": ["DOM", "ES2023", "esnext.disposable"],

    "outDir": "../../dist/types/client",

    // React
    "jsx": "react-jsx",

    // Not in dist/client: Devvit uploads everything there, and the client build empties it,
    // which threw away tsc's incremental state on every build.
    "tsBuildInfoFile": "../../dist/types/client/tsconfig.tsbuildinfo"
  },
  // https://github.com/Microsoft/TypeScript/issues/25636
  "include": ["**/*", "**/*.json"],
  "exclude": ["**/*.test.ts"],
  "references": [{ "path": "../shared" }]
}
